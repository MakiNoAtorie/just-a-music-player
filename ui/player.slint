import { VerticalBox, HorizontalBox, ListView, ScrollView, AboutSlint, Palette } from "std-widgets.slint";
export struct QueueItem { title: string, artist: string, duration: string }

global Skin {
    in-out property <bool> dark: true;
    out property <color> page: dark ? #121716 : #f6f8f6;
    out property <color> surface: dark ? #1c2421 : #ffffff;
    out property <color> hover: dark ? #29352f : #e9f1eb;
    out property <color> selected: dark ? #294233 : #dcf0e0;
    // Purple marks the playing row so it never reads as the (green) selected row.
    out property <color> playing: dark ? #35283f : #ecddf7;
    out property <color> playing-ink: dark ? #dfb9f3 : #69317f;
    out property <color> line: dark ? #34413a : #dce5dd;
    out property <color> ink: dark ? #f0f5f0 : #17291c;
    out property <color> secondary: dark ? #aab9af : #52675a;
    out property <color> faint: dark ? #82958a : #5b7063;
    out property <color> accent: dark ? #b9edc1 : #286b3e;
    out property <color> accent-hover: dark ? #d2f5d7 : #347f4b;
    out property <color> primary-ink: dark ? #183320 : #ffffff;
    out property <color> warn: dark ? #f0c674 : #8a5a00;
}

// Text of the control under the pointer; shown in the footer line.
global Hint { in-out property <string> text; }

component Action inherits Rectangle {
    in property <string> text;
    in property <image> glyph;
    in property <bool> active;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <string> hint: text;
    in property <length> box-size: primary ? 46px : 32px;
    in property <length> icon-size: 19px;
    // Hit/layout height; the visible box is centred inside it so mixed sizes share a centre line.
    in property <length> slot: box-size;
    callback clicked;
    min-width: text == "" ? max(34px, box-size) : label.preferred-width + 24px;
    height: slot;
    horizontal-stretch: 0;
    preferred-width: self.min-width;
    accessible-role: button; accessible-label: hint; accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    box := Rectangle {
        y: (parent.height - self.height) / 2; width: parent.width; height: root.box-size;
        border-radius: root.primary ? root.box-size / 2 : 8px;
        background: !root.enabled ? Skin.surface : root.primary ? (touch.has-hover ? Skin.accent-hover : Skin.accent) : root.active ? Skin.selected : touch.has-hover ? Skin.hover : Skin.surface;
        border-width: root.primary ? 0px : 1px;
        border-color: root.active ? Skin.accent : Skin.line;
        label := Text { text: root.text; color: !root.enabled ? Skin.faint : root.primary ? Skin.primary-ink : root.active ? Skin.accent : Skin.ink; font-size: root.primary ? 16px : 12px; font-weight: root.primary ? 600 : 500; horizontal-alignment: center; vertical-alignment: center; visible: root.text != ""; }
        if root.text == "": Image { source: root.glyph; x: (parent.width - root.icon-size) / 2; y: (parent.height - root.icon-size) / 2; width: root.icon-size; height: root.icon-size; image-fit: contain; colorize: !root.enabled ? Skin.faint : root.primary ? Skin.primary-ink : root.active ? Skin.accent : Skin.ink; opacity: root.enabled ? 1 : 0.45; }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover { Hint.text = root.hint; } else if Hint.text == root.hint { Hint.text = ""; }
        }
    }
}

component Seek inherits TouchArea {
    in property <float> progress;
    in property <length> thickness: 4px;
    in property <length> thumb: 10px;
    callback seek(float);
    property <float> shown: self.pressed ? max(0, min(1, self.mouse-x / self.width)) : root.progress;
    mouse-cursor: pointer;
    accessible-role: slider; accessible-label: "Playback position"; accessible-enabled: root.enabled;
    accessible-value: root.progress; accessible-value-minimum: 0; accessible-value-maximum: 1;
    accessible-action-set-value(value) => { if value.is-float() { root.seek(max(0, min(1, value.to-float()))); } }
    accessible-action-increment => { root.seek(min(1, root.progress + 0.01)); }
    accessible-action-decrement => { root.seek(max(0, root.progress - 0.01)); }
    Rectangle { x: 0px; y: (parent.height - root.thickness) / 2; width: parent.width; height: root.thickness; border-radius: root.thickness / 2; background: Skin.line;
        Rectangle { x: 0px; width: parent.width * root.shown; background: Skin.accent; border-radius: parent.border-radius; }
    }
    // No thumb while nothing is loaded: a lit handle on a dead bar reads as interactive.
    if root.enabled: Rectangle { x: (parent.width - root.thumb) * root.shown; y: (parent.height - root.thumb) / 2; width: root.thumb; height: root.thumb; border-radius: root.thumb / 2; background: Skin.accent; }
    clicked => { root.seek(max(0, min(1, self.mouse-x / self.width))); }
}

component Switch inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in-out property <bool> checked;
    callback toggled;
    height: 46px;
    accessible-role: switch; accessible-label: label; accessible-checkable: true; accessible-checked: checked;
    accessible-action-default => { root.toggled(); }
    VerticalLayout { alignment: center; spacing: 2px; padding-right: 52px;
        Text { text: root.label; color: Skin.ink; font-size: 13px; }
        Text { text: root.hint; color: Skin.faint; font-size: 11px; wrap: word-wrap; }
    }
    Rectangle { x: parent.width - 40px; y: (parent.height - 22px) / 2; width: 40px; height: 22px; border-radius: 11px; background: root.checked ? Skin.accent : Skin.line;
        Rectangle { x: root.checked ? 20px : 2px; y: 2px; width: 18px; height: 18px; border-radius: 9px; background: root.checked ? Skin.primary-ink : Skin.faint; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

export component PlayerWindow inherits Window {
    title: root.playing ? root.track-title + " — Just a music player" : "Just a music player";
    preferred-width: 460px; preferred-height: 660px;
    min-width: root.compact ? 320px : 400px;
    min-height: root.compact ? 84px : 580px;
    max-height: root.compact ? 84px : 16384px;
    // `pinned` is a saved preference; it only takes effect (on top, no title bar) while in Mini.
    no-frame: root.compact && root.pinned;
    always-on-top: root.compact && root.pinned;
    background: Skin.page;
    default-font-family: "Segoe UI"; default-font-size: 13px;
    icon: @image-url("../assets/icon.png");
    in-out property <bool> dark-mode: true;
    in-out property <bool> compact: false;
    in-out property <bool> pinned: false;
    in-out property <bool> float-on-blur: false;
    // Auto-float is built but parked: set to true to show its Settings switch and enable the behaviour.
    out property <bool> show-float-setting: false;
    // The OS preference, read once before anything overrides Palette.
    out property <bool> system-dark: true;
    public function apply-theme() {
        Skin.dark = root.dark-mode;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => { root.apply-theme(); }
    init => {
        root.system-dark = Palette.color-scheme != ColorScheme.light;
        Skin.dark = root.dark-mode;
    }
    in property <[QueueItem]> queue;
    in property <int> current: -1;
    in-out property <int> selected: -1;
    in property <bool> playing;
    in property <string> track-title: "Nothing playing";
    in property <string> track-artist;
    in property <string> track-album;
    in property <image> cover;
    in property <bool> has-cover;
    in property <float> progress;
    in property <string> elapsed: "0:00";
    in property <string> total: "0:00";
    in property <float> volume: 0.8;
    in property <bool> muted;
    in property <bool> shuffle;
    in property <int> repeat-mode;
    in property <string> notice;
    in property <bool> notice-info;
    in property <bool> loading;
    in property <string> version;
    in-out property <bool> about-visible;
    callback open-files; callback open-folder; callback transport(string);
    callback seek(float); callback change-volume(float); callback play-track(int);
    callback remove-track(int); callback move-track(int, int); callback clear-queue;
    callback change-look(bool, bool, bool, bool); // dark, compact, pinned, float-on-blur
    callback drag-window;

    if !root.compact: VerticalBox {
        padding: 22px;
        spacing: 16px;
        HorizontalBox { height: 32px; spacing: 7px; padding-top: 0px; padding-bottom: 0px;
            Rectangle { horizontal-stretch: 1; }
            Action { glyph: root.dark-mode ? @image-url("../assets/sun.svg") : @image-url("../assets/moon.svg"); hint: root.dark-mode ? "Switch to light theme" : "Switch to dark theme"; clicked => { root.change-look(!root.dark-mode, false, root.pinned, root.float-on-blur); } }
            Action { text: "Mini"; hint: "Show the minimal player"; clicked => { root.change-look(root.dark-mode, true, root.pinned, root.float-on-blur); } }
            Action { text: "?"; hint: "Settings, shortcuts and credits"; clicked => { root.about-visible = !root.about-visible; } }
        }
        HorizontalBox { height: 92px; spacing: 16px;
            Rectangle { width: 92px; height: 92px; border-radius: 10px; background: Skin.surface; border-width: 1px; border-color: Skin.line; clip: true;
                if root.has-cover: Image { source: root.cover; image-fit: ImageFit.cover; }
                if !root.has-cover: Image { source: @image-url("../assets/music.svg"); x: 28px; y: 28px; width: 36px; height: 36px; colorize: Skin.faint; }
            }
            VerticalBox { padding: 0px; spacing: 3px;
                Text { text: root.playing ? "NOW PLAYING" : root.current < 0 ? "YOUR MUSIC" : root.progress > 0 ? "PAUSED" : "READY TO PLAY"; color: Skin.accent; font-size: 10px; font-weight: 600; }
                Text { text: root.track-title; color: Skin.ink; font-size: 20px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                Text { text: root.track-artist; color: Skin.secondary; overflow: elide; vertical-alignment: center; }
                Text { text: root.track-album; color: Skin.faint; font-size: 11px; overflow: elide; }
            }
        }
        VerticalBox { spacing: 3px; height: 43px; padding-top: 0px; padding-bottom: 0px;
            Seek { height: 24px; enabled: root.current >= 0; progress: root.progress; seek(f) => { root.seek(f); } }
            Rectangle { height: 16px;
                Text { x: 0px; width: 70px; height: parent.height; text: root.elapsed; color: Skin.faint; font-size: 11px; vertical-alignment: center; }
                Text { x: parent.width - self.width; width: 70px; height: parent.height; text: root.total; color: Skin.faint; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; }
            }
        }
        HorizontalBox { alignment: center; spacing: 13px; height: 46px; padding-top: 0px; padding-bottom: 0px;
            Action { glyph: @image-url("../assets/shuffle.svg"); slot: 46px; active: root.shuffle; hint: "Shuffle (S)"; clicked => { root.transport("shuffle"); } }
            Action { glyph: @image-url("../assets/previous.svg"); slot: 46px; hint: "Previous (F1)"; enabled: root.current >= 0; clicked => { root.transport("previous"); } }
            Action { glyph: root.playing ? @image-url("../assets/pause.svg") : @image-url("../assets/play.svg"); width: 46px; primary: true; enabled: root.queue.length > 0; hint: "Play or pause (Space)"; clicked => { root.transport("toggle"); } }
            Action { glyph: @image-url("../assets/next.svg"); slot: 46px; hint: "Next (F2)"; enabled: root.current >= 0; clicked => { root.transport("next"); } }
            Action { glyph: root.repeat-mode == 2 ? @image-url("../assets/repeat-one.svg") : @image-url("../assets/repeat.svg"); slot: 46px; active: root.repeat-mode > 0; hint: "Repeat (R)"; clicked => { root.transport("repeat"); } }
        }
        HorizontalBox { alignment: center; spacing: 9px; height: 32px; padding-top: 0px; padding-bottom: 0px;
            Action { glyph: root.muted ? @image-url("../assets/mute.svg") : @image-url("../assets/volume.svg"); active: root.muted; hint: "Mute (M)"; clicked => { root.transport("mute"); } }
            volume-touch := TouchArea { width: 140px; height: 32px; mouse-cursor: pointer;
                accessible-role: slider; accessible-label: "Volume";
                accessible-value: root.volume; accessible-value-minimum: 0; accessible-value-maximum: 1;
                accessible-action-set-value(value) => { if value.is-float() { root.change-volume(max(0, min(1, value.to-float()))); } }
                accessible-action-increment => { root.change-volume(min(1, root.volume + 0.05)); }
                accessible-action-decrement => { root.change-volume(max(0, root.volume - 0.05)); }
                Rectangle { x: 0px; y: 14px; width: parent.width; height: 4px; border-radius: 2px; background: Skin.line;
                    Rectangle { x: 0px; width: parent.width * root.volume; background: root.muted ? Skin.faint : Skin.accent; border-radius: 2px; }
                }
                Rectangle { x: (parent.width - 12px) * root.volume; y: 10px; width: 12px; height: 12px; border-radius: 6px; background: root.muted ? Skin.faint : Skin.accent; }
                clicked => { root.change-volume(max(0, min(1, self.mouse-x / self.width))); }
                moved => { if self.pressed { root.change-volume(max(0, min(1, self.mouse-x / self.width))); } }
            }
            Text { width: 35px; text: round(root.volume * 100) + "%"; color: Skin.faint; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; }
        }
        Rectangle { height: 1px; background: Skin.line; }
        VerticalBox { spacing: 8px; vertical-stretch: 1;
            HorizontalBox { height: 32px; spacing: 7px; padding-top: 0px; padding-bottom: 0px;
                Text { text: "QUEUE  " + root.queue.length; color: Skin.secondary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Action { text: "Clear"; hint: "Clear queue (Ctrl+Delete)"; enabled: root.queue.length > 0; clicked => { root.clear-queue(); root.selected = -1; } }
                Action { text: "+ Files"; hint: "Add files (Ctrl+O)"; clicked => { root.open-files(); } }
                Action { text: "+ Folder"; hint: "Add folder (Ctrl+Shift+O)"; clicked => { root.open-folder(); } }
            }
            Rectangle { min-height: 110px; vertical-stretch: 1; background: Skin.surface; border-radius: 9px; border-width: 1px; border-color: Skin.line; clip: true;
                if root.queue.length == 0: Text { text: "Add files or a folder, or drop music here"; color: Skin.faint; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                if root.queue.length > 0: Rectangle {
                    // Keep the keyboard selection and the playing row on screen.
                    property <int> sel: root.selected;
                    property <int> cur: root.current;
                    function reveal(i: int) {
                        if i < 0 { return; }
                        if i * 54px < -list.content-y { list.content-y = -(i * 54px); }
                        else if (i + 1) * 54px > -list.content-y + list.visible-height { list.content-y = -((i + 1) * 54px - list.visible-height); }
                    }
                    changed sel => { self.reveal(self.sel); }
                    changed cur => { self.reveal(self.cur); }
                    list := ListView {
                        for track[index] in root.queue: Rectangle { height: 54px;
                            background: index == root.current ? Skin.playing : index == root.selected ? Skin.selected : row-touch.has-hover ? Skin.hover : Skin.surface;
                            border-width: index == root.current && index == root.selected ? 1px : 0px;
                            border-color: Skin.accent;
                            accessible-role: list-item;
                            accessible-label: track.title + (track.artist == "" ? "" : ", " + track.artist);
                            accessible-action-default => { root.selected = index; root.play-track(index); }
                            row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected = index; } double-clicked => { root.selected = index; root.play-track(index); } }
                            if index == root.current: Rectangle { x: 0px; width: 4px; height: parent.height; background: Skin.playing-ink; }
                            HorizontalBox { padding: 8px; spacing: 10px;
                                Text { width: 25px; text: index == root.current ? "▶" : index + 1; color: index == root.current ? Skin.playing-ink : Skin.faint; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                                VerticalBox { padding: 0px; spacing: 2px;
                                    Text { text: track.title; color: index == root.current ? Skin.playing-ink : Skin.ink; overflow: elide; vertical-alignment: center; }
                                    Text { text: track.artist == "" ? "Unknown artist" : track.artist; color: Skin.faint; font-size: 11px; overflow: elide; vertical-alignment: center; }
                                }
                                // Row actions appear on the selected row only: no permanent toolbar.
                                Rectangle { width: 94px;
                                    if index != root.selected: Text { text: track.duration; color: Skin.faint; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; }
                                    if index == root.selected: HorizontalLayout { alignment: end; spacing: 2px;
                                        Action { glyph: @image-url("../assets/up.svg"); box-size: 28px; icon-size: 16px; hint: "Move up (Alt+Up)"; enabled: index > 0; clicked => { root.move-track(index, index - 1); root.selected = index - 1; } }
                                        Action { glyph: @image-url("../assets/down.svg"); box-size: 28px; icon-size: 16px; hint: "Move down (Alt+Down)"; enabled: index < root.queue.length - 1; clicked => { root.move-track(index, index + 1); root.selected = index + 1; } }
                                        Action { glyph: @image-url("../assets/remove.svg"); box-size: 28px; icon-size: 16px; hint: "Remove (Delete)"; clicked => { root.remove-track(index); root.selected = min(index, root.queue.length - 2); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Text { height: root.notice == "" ? 16px : 30px; text: root.notice != "" ? root.notice : root.loading ? "Adding your music…" : Hint.text != "" ? Hint.text : root.queue.length > 0 ? "Double-click a track to play" : ""; color: root.notice != "" ? (root.notice-info ? Skin.accent : Skin.warn) : Skin.faint; font-size: 11px; wrap: word-wrap; }
    }

    // Mini: one strip. Transport left, title/time right, seek line underneath.
    if root.compact: Rectangle {
        TouchArea {
            // When pinned there is no title bar: any press that isn't on a control drags the window.
            pointer-event(event) => {
                if root.pinned && event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-window(); }
            }
            scroll-event(event) => {
                root.change-volume(max(0, min(1, root.volume + (event.delta-y > 0 ? 0.05 : -0.05))));
                accept
            }
        }
        HorizontalLayout { x: 12px; y: 6px; width: 100px; height: 40px; spacing: 4px;
            Action { glyph: @image-url("../assets/previous.svg"); box-size: 28px; icon-size: 16px; slot: 40px; hint: "Previous (F1)"; enabled: root.current >= 0; clicked => { root.transport("previous"); } }
            Action { glyph: root.playing ? @image-url("../assets/pause.svg") : @image-url("../assets/play.svg"); width: 36px; box-size: 36px; slot: 40px; primary: true; enabled: root.queue.length > 0; hint: "Play or pause (Space)"; clicked => { root.transport("toggle"); } }
            Action { glyph: @image-url("../assets/next.svg"); box-size: 28px; icon-size: 16px; slot: 40px; hint: "Next (F2)"; enabled: root.current >= 0; clicked => { root.transport("next"); } }
        }
        Rectangle { x: 124px; y: 7px; width: parent.width - 124px - 54px; height: 38px;
            Text { y: 0px; width: parent.width; height: 20px; text: root.track-title; color: Skin.ink; font-size: 14px; font-weight: 600; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
            HorizontalLayout { y: 21px; width: parent.width; height: 16px; alignment: center; spacing: 8px;
                Text { text: root.notice != "" ? root.notice : root.track-artist; color: root.notice != "" ? (root.notice-info ? Skin.accent : Skin.warn) : Skin.secondary; font-size: 12px; overflow: elide; vertical-alignment: center; }
                Text { text: root.elapsed + " / " + root.total; color: Skin.faint; font-size: 11px; vertical-alignment: center; }
            }
        }
        Action { x: parent.width - 46px; y: 4px; width: 34px; glyph: @image-url("../assets/expand.svg"); box-size: 24px; icon-size: 14px; slot: 24px; hint: "Show the full player"; clicked => { root.change-look(root.dark-mode, false, root.pinned, root.float-on-blur); } }
        Action { x: parent.width - 46px; y: 28px; width: 34px; glyph: @image-url("../assets/pin.svg"); box-size: 24px; icon-size: 14px; slot: 24px; active: root.pinned; hint: root.pinned ? "Unpin (show the title bar)" : "Pin on top (hides the title bar)"; clicked => { root.change-look(root.dark-mode, true, !root.pinned, root.float-on-blur); } }
        Seek { x: 12px; y: 52px; width: parent.width - 24px; height: 24px; thickness: 3px; thumb: 8px; enabled: root.current >= 0; progress: root.progress; seek(f) => { root.seek(f); } }
        // Without a title bar the window needs its own edge.
        if root.pinned: Rectangle { border-width: 1px; border-color: Skin.line; }
    }

    if root.about-visible: Rectangle { background: Skin.page;
        TouchArea { } // swallow clicks so the hidden player can't be operated through the overlay
        VerticalBox { padding: 24px; spacing: 12px;
            HorizontalBox { height: 32px; padding-top: 0px; padding-bottom: 0px;
                Text { text: "Settings"; color: Skin.ink; font-size: 22px; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Action { text: "Done"; hint: "Back to music (Esc)"; clicked => { root.about-visible = false; } }
            }
            ScrollView {
                VerticalLayout { spacing: 8px; padding-right: 14px;
                    Text { text: "APPEARANCE"; color: Skin.secondary; font-size: 11px; font-weight: 600; }
                    HorizontalLayout { height: 34px; spacing: 6px;
                        Text { text: "Theme"; color: Skin.ink; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: "Light"; active: !root.dark-mode; clicked => { root.change-look(false, false, root.pinned, root.float-on-blur); } }
                        Action { text: "Dark"; active: root.dark-mode; clicked => { root.change-look(true, false, root.pinned, root.float-on-blur); } }
                    }
                    if root.show-float-setting: Switch { label: "Float the mini player when I switch windows"; hint: "It stays on top with no title bar. Press the expand button to bring the full player back."; checked: root.float-on-blur; toggled => { root.change-look(root.dark-mode, root.compact, root.pinned, !root.float-on-blur); } }
                    Rectangle { height: 8px; }
                    Text { text: "SHORTCUTS"; color: Skin.secondary; font-size: 11px; font-weight: 600; }
                    GridLayout { spacing-vertical: 5px; spacing-horizontal: 12px;
                        Row { Text { text: "Space"; color: Skin.accent; font-size: 12px; } Text { text: "Play / pause"; color: Skin.ink; font-size: 12px; } Text { text: "F1 / F2"; color: Skin.accent; font-size: 12px; } Text { text: "Previous / next"; color: Skin.ink; font-size: 12px; } }
                        Row { Text { text: "← / →"; color: Skin.accent; font-size: 12px; } Text { text: "Seek 5 seconds"; color: Skin.ink; font-size: 12px; } Text { text: "+ / −"; color: Skin.accent; font-size: 12px; } Text { text: "Volume"; color: Skin.ink; font-size: 12px; } }
                        Row { Text { text: "M"; color: Skin.accent; font-size: 12px; } Text { text: "Mute"; color: Skin.ink; font-size: 12px; } Text { text: "X"; color: Skin.accent; font-size: 12px; } Text { text: "Stop"; color: Skin.ink; font-size: 12px; } }
                        Row { Text { text: "S"; color: Skin.accent; font-size: 12px; } Text { text: "Shuffle"; color: Skin.ink; font-size: 12px; } Text { text: "R"; color: Skin.accent; font-size: 12px; } Text { text: "Cycle repeat"; color: Skin.ink; font-size: 12px; } }
                        Row { Text { text: "Ctrl+O"; color: Skin.accent; font-size: 12px; } Text { text: "Add files"; color: Skin.ink; font-size: 12px; } Text { text: "Ctrl+Shift+O"; color: Skin.accent; font-size: 12px; } Text { text: "Add folder"; color: Skin.ink; font-size: 12px; } }
                        Row { Text { text: "↑ / ↓"; color: Skin.accent; font-size: 12px; } Text { text: "Select track"; color: Skin.ink; font-size: 12px; } Text { text: "Enter"; color: Skin.accent; font-size: 12px; } Text { text: "Play"; color: Skin.ink; font-size: 12px; } }
                        Row { Text { text: "Delete"; color: Skin.accent; font-size: 12px; } Text { text: "Remove"; color: Skin.ink; font-size: 12px; } Text { text: "Ctrl+Delete"; color: Skin.accent; font-size: 12px; } Text { text: "Clear queue"; color: Skin.ink; font-size: 12px; } }
                        Row { Text { text: "Alt+↑ / ↓"; color: Skin.accent; font-size: 12px; } Text { text: "Reorder"; color: Skin.ink; font-size: 12px; } Text { text: "Mini + wheel"; color: Skin.accent; font-size: 12px; } Text { text: "Volume"; color: Skin.ink; font-size: 12px; } }
                    }
                    Rectangle { height: 8px; }
                    Text { text: "ABOUT"; color: Skin.secondary; font-size: 11px; font-weight: 600; }
                    Text { text: "Just a music player  ·  version " + root.version; color: Skin.ink; font-weight: 600; }
                    Text { text: "Designed and directed by Makisatelier, from the first spec through every round of polish. Coded by AI: Claude (Anthropic) and Codex (OpenAI)."; color: Skin.secondary; font-size: 12px; wrap: word-wrap; }
                    Text { text: "Built with Rust and open-source libraries (Slint, Symphonia, Rubato, CPAL, lofty and more). The app's own code is MIT licensed; its UI toolkit is used under the Slint royalty-free license. Full list: THIRD_PARTY_NOTICES.md."; color: Skin.faint; font-size: 11px; wrap: word-wrap; }
                    AboutSlint { height: 72px; }
                }
            }
        }
    }
}
